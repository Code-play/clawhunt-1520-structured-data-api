{
  "version": "1.0.0",
  "description": "演示用令牌表。明文令牌仅用于本地可复现验收；生产环境应改为哈希存储 + 定期轮换 + 最小 scope。",
  "header": "X-API-Token",
  "tokens": [
    {
      "id": "demo-readonly",
      "token": "demo-readonly-7f3a",
      "scopes": [
        "query",
        "audit"
      ],
      "rate_limit": {
        "limit": 60,
        "window_seconds": 60
      },
      "note": "常规只读调用方：可查数据、可读审计尾部"
    },
    {
      "id": "demo-audit-only",
      "token": "demo-audit-2b91",
      "scopes": [
        "audit"
      ],
      "rate_limit": {
        "limit": 30,
        "window_seconds": 60
      },
      "note": "只给审计 scope，用于验证越权查数被拒（403）"
    },
    {
      "id": "demo-burst",
      "token": "demo-burst-55cd",
      "scopes": [
        "query",
        "audit"
      ],
      "rate_limit": {
        "limit": 5,
        "window_seconds": 60
      },
      "note": "低配额的突发令牌，用于验证滑动窗口限流（429）"
    },
    {
      "id": "demo-query-only",
      "token": "demo-query-91ce",
      "scopes": [
        "query"
      ],
      "rate_limit": {
        "limit": 30,
        "window_seconds": 60
      },
      "note": "只有 query scope，用于验证读审计尾部被拒（403）"
    }
  ]
}
